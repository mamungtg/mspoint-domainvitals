# Copy to /opt/domainvitals/.env on the server (chmod 600). Never commit real values.

# --- Cloudflare Tunnel (Zero Trust > Networks > Tunnels > your tunnel > token) ---
TUNNEL_TOKEN=

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=change-me-run: python3 -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_ALLOWED_HOSTS=app.mspointit.com,api.mspointit.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.mspointit.com
FRONTEND_URL=https://app.mspointit.com
ENABLE_ADMIN=false

# --- Database (used by both Postgres container and Django) ---
POSTGRES_DB=domainvitals
POSTGRES_USER=domainvitals
POSTGRES_PASSWORD=change-me-long-random
DATABASE_URL=postgres://domainvitals:change-me-long-random@db:5432/domainvitals

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Outgoing mail (SMTP) ---
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=DomainVitals <no-reply@mspointit.com>

# --- Stripe (Sprint 5) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
